<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MandelbrotActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:label="@string/menu_help" />
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="@string/menu_about" />
        <activity
            android:name=".IterationSettingsActivity"
            android:exported="false"
            android:label="@string/menu_iterations" />
        <activity
            android:name=".PhoenixParamsActivity"
            android:exported="false"
            android:label="@string/phoenix_custom_title" />
        <activity
            android:name=".JuliaParamsActivity"
            android:exported="false"
            android:label="@string/julia_custom_title" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
