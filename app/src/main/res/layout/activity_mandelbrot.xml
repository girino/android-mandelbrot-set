<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mandelbrot_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fractal_canvas">

    <org.girino.frac.android.foss.MandelbrotView
        android:id="@+id/mandelbrot_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Issue #9: determinate bar weighted by progressive samples. -->
    <ProgressBar
        android:id="@+id/render_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:contentDescription="@string/render_progress_cd"
        android:indeterminate="false"
        android:max="100"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:progress="0"
        android:progressBackgroundTint="#33FFFFFF"
        android:progressTint="#E6FFFFFF"
        android:visibility="gone" />

    <!-- Compact bottom HUD: common actions (no options menu). -->
    <LinearLayout
        android:id="@+id/hud_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/hud_bar_background"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/hud_formula"
            style="@style/HudButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:contentDescription="@string/hud_formula_cd"
            android:text="@string/menu_formula" />

        <Button
            android:id="@+id/hud_palette"
            style="@style/HudButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:contentDescription="@string/hud_palette_cd"
            android:text="@string/menu_palette" />

        <Button
            android:id="@+id/hud_zoom_out"
            style="@style/HudButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:contentDescription="@string/hud_zoom_out_cd"
            android:text="@string/hud_zoom_out" />

        <Button
            android:id="@+id/hud_zoom_in"
            style="@style/HudButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:contentDescription="@string/hud_zoom_in_cd"
            android:text="@string/hud_zoom_in" />

        <ToggleButton
            android:id="@+id/hud_smooth"
            style="@style/HudToggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:contentDescription="@string/hud_smooth_cd"
            android:textOff="@string/menu_smooth_palette"
            android:textOn="@string/menu_smooth_palette" />

        <Button
            android:id="@+id/hud_reset"
            style="@style/HudButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/hud_reset_cd"
            android:text="@string/menu_reset" />
    </LinearLayout>
</FrameLayout>
