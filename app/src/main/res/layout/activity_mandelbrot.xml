<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mandelbrot_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fractal_canvas">

    <org.girino.frac.android.foss.MandelbrotView
        android:id="@+id/mandelbrot_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Issue #9 / #31: determinate for progressive steps; indeterminate for Adaptive. -->
    <ProgressBar
        android:id="@+id/render_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:contentDescription="@string/render_progress_cd"
        android:indeterminate="false"
        android:indeterminateTint="#E6FFFFFF"
        android:max="100"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:progress="0"
        android:progressBackgroundTint="#33FFFFFF"
        android:progressTint="#E6FFFFFF"
        android:visibility="gone" />

    <!-- Issue #17: optional formula + smooth status; tap overlay to hide, chip to show. -->
    <TextView
        android:id="@+id/status_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/status_overlay_background"
        android:clickable="true"
        android:contentDescription="@string/status_overlay_cd"
        android:elevation="4dp"
        android:focusable="true"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/hud_text" />

    <TextView
        android:id="@+id/status_overlay_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/status_overlay_background"
        android:clickable="true"
        android:contentDescription="@string/status_overlay_show_cd"
        android:elevation="4dp"
        android:focusable="true"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="@string/status_overlay_chip"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/hud_text"
        android:visibility="gone" />

    <!-- Issue #29: icon bar (+, −, Reset, Smooth) + hamburger overflow. -->
    <LinearLayout
        android:id="@+id/hud_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/hud_bar_background"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/hud_zoom_in"
            style="@style/HudIconButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/hud_zoom_in_cd"
            android:src="@drawable/ic_hud_zoom_in" />

        <ImageButton
            android:id="@+id/hud_zoom_out"
            style="@style/HudIconButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/hud_zoom_out_cd"
            android:src="@drawable/ic_hud_zoom_out" />

        <ImageButton
            android:id="@+id/hud_reset"
            style="@style/HudIconButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/hud_reset_cd"
            android:src="@drawable/ic_hud_reset" />

        <ImageButton
            android:id="@+id/hud_smooth"
            style="@style/HudIconButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/hud_smooth_cd"
            android:src="@drawable/ic_hud_smooth" />

        <ImageButton
            android:id="@+id/hud_menu"
            style="@style/HudIconButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/hud_menu_cd"
            android:src="@drawable/ic_hud_menu" />
    </LinearLayout>
</FrameLayout>
