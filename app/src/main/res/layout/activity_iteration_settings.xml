<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/iteration_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/hud_text"
        app:titleTextColor="@color/hud_text" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/iteration_mode_label"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/md_theme_on_surface" />

            <RadioGroup
                android:id="@+id/iteration_mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/iteration_mode_fixed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/iteration_mode_fixed"
                    android:textColor="@color/md_theme_on_surface" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/iteration_mode_zoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/iteration_mode_zoom"
                    android:textColor="@color/md_theme_on_surface" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/iteration_mode_adaptive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/iteration_mode_adaptive"
                    android:textColor="@color/md_theme_on_surface" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/iteration_defaults_summary"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_theme_on_surface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/iteration_fixed_label"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/md_theme_on_surface" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/iteration_fixed_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/iteration_fixed_hint"
                app:helperText="@string/iteration_fixed_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/iteration_fixed_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/iteration_zoom_section"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/md_theme_on_surface" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/iteration_base_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/iteration_base_hint"
                app:helperText="@string/iteration_base_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/iteration_base_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/iteration_multiplier_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/iteration_multiplier_hint"
                app:helperText="@string/iteration_multiplier_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/iteration_multiplier_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/iteration_adaptive_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/iteration_adaptive_section"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/md_theme_on_surface" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/iteration_rounds_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/iteration_rounds_hint"
                app:helperText="@string/iteration_rounds_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/iteration_rounds_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/iteration_cap_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/iteration_cap_hint"
                app:helperText="@string/iteration_cap_helper">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/iteration_cap_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/iteration_help"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/md_theme_on_surface" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/iteration_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/iteration_reset_defaults"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/iteration_reset_defaults" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/iteration_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/iteration_save" />
    </LinearLayout>
</LinearLayout>
